### Admin only
GET http://localhost:8080/api/admin/ping
Authorization: Bearer {{adminToken}}
### Me without token
GET http://localhost:8080/api/me

### Register admin
POST http://localhost:8080/api/auth/register
Content-Type: application/json

{
  "fullName": "Test Admin",
  "email": "admin@test.com",
  "password": "123456",
  "role": "ADMIN"
}


### Login admin
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "email": "admin@test.com",
  "password": "123456"
}

> {%
    client.global.set("adminToken", response.body.token);
%}



### Create student (admin)
POST http://localhost:8080/api/admin/students
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "fullName": "Rahul Sharma",
  "email": "rahul@test.com",
  "password": "123456",
  "rollNo": "CSE2023001",
  "course": "B.Tech CSE",
  "semester": 5
}

### List students (admin)
GET http://localhost:8080/api/admin/students
Authorization: Bearer {{adminToken}}

### Get student 1 (admin)
GET http://localhost:8080/api/admin/students/1
Authorization: Bearer {{adminToken}}

### Update student 1 (admin)
PUT http://localhost:8080/api/admin/students/1
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "fullName": "Rahul Kumar Sharma",
  "course": "B.Tech CSE",
  "semester": 6
}

### Delete student 1 (admin)
DELETE http://localhost:8080/api/admin/students/1
Authorization: Bearer {{adminToken}}

### Login as the new student
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "email": "rahul@test.com",
  "password": "123456"
}

> {%
    client.global.set("studentToken", response.body.token);
%}

### My profile (student)
GET http://localhost:8080/api/student/me
Authorization: Bearer {{studentToken}}




### Create faculty (admin)
POST http://localhost:8080/api/admin/faculty
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "fullName": "Dr. Anita Verma",
  "email": "anita@test.com",
  "password": "123456",
  "employeeId": "EMP1001",
  "department": "Computer Science"
}

### List faculty (admin)
GET http://localhost:8080/api/admin/faculty
Authorization: Bearer {{adminToken}}

### Update faculty 1 (admin)
PUT http://localhost:8080/api/admin/faculty/1
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "fullName": "Dr. Anita Verma",
  "department": "Information Technology"
}

### Login as faculty
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "email": "anita@test.com",
  "password": "123456"
}

> {%
    client.global.set("facultyToken", response.body.token);
%}

### My profile (faculty)
GET http://localhost:8080/api/faculty/me
Authorization: Bearer {{facultyToken}}

### Faculty tries admin API (should fail)
GET http://localhost:8080/api/admin/faculty
Authorization: Bearer {{facultyToken}}

### Student tries faculty API (should fail)
GET http://localhost:8080/api/faculty/me
Authorization: Bearer {{studentToken}}





### Create course (admin)
POST http://localhost:8080/api/admin/courses
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "code": "BTCSE",
  "name": "B.Tech CSE",
  "totalSemesters": 8
}

### Create subject (admin)
POST http://localhost:8080/api/admin/subjects
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "code": "CS501",
  "name": "Database Management Systems",
  "semester": 5,
  "courseId": 1
}

### Subject with invalid semester (should fail)
POST http://localhost:8080/api/admin/subjects
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "code": "CS999",
  "name": "Invalid Subject",
  "semester": 9,
  "courseId": 1
}

### Assign faculty 1 to subject 1 (admin)
PUT http://localhost:8080/api/admin/subjects/1/faculty/1
Authorization: Bearer {{adminToken}}

### My subjects (faculty)
GET http://localhost:8080/api/faculty/subjects
Authorization: Bearer {{facultyToken}}

### List courses (student)
GET http://localhost:8080/api/courses
Authorization: Bearer {{studentToken}}

### Subjects of course 1 (student)
GET http://localhost:8080/api/subjects?courseId=1
Authorization: Bearer {{studentToken}}

### Student tries to create course (should fail)
POST http://localhost:8080/api/admin/courses
Content-Type: application/json
Authorization: Bearer {{studentToken}}

{
  "code": "X",
  "name": "X",
  "totalSemesters": 4
}

### Delete course 1 (should fail, has subjects)
DELETE http://localhost:8080/api/admin/courses/1
Authorization: Bearer {{adminToken}}