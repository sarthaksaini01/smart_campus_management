### GET request to example server
GET https://examples.http-client.intellij.net/get
    ?generated-in=IntelliJ IDEA

###

### Register student
POST http://localhost:8080/api/auth/register
Content-Type: application/json

{
  "fullName": "Test Student",
  "email": "student@test.com",
  "password": "123456",
  "role": "STUDENT"
}

### Login
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "email": "student@test.com",
  "password": "123456"
}

### Me (any logged in user)
GET http://localhost:8080/api/me
Authorization: Bearer eyJhbGciOiJIUzM4NCJ9.eyJzdWIiOiJzdHVkZW50QHRlc3QuY29tIiwicm9sZSI6IlNUVURFTlQiLCJpYXQiOjE3OTE1NDM4ODYsImV4cCI6MTc5MTYzMDI4Nn0.gZ88DfyS3brbFdwiXDjXPoaLGY76v1tj7M_RjqFjYCPLcLm1S6GfiPS2YsUL6nHs

### Admin only
GET http://localhost:8080/api/admin/ping
Authorization: Bearer {{adminToken}}
### Me without token
GET http://localhost:8080/api/me

### Register admin
POST http://localhost:8080/api/auth/register
Content-Type: application/json

{
  "fullName": "Test Admin",
  "email": "admin@test.com",
  "password": "123456",
  "role": "ADMIN"
}


### Login admin
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "email": "admin@test.com",
  "password": "123456"
}

> {%
    client.global.set("adminToken", response.body.token);
%}



### Create student (admin)
POST http://localhost:8080/api/admin/students
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "fullName": "Rahul Sharma",
  "email": "rahul@test.com",
  "password": "123456",
  "rollNo": "CSE2023001",
  "course": "B.Tech CSE",
  "semester": 5
}

### List students (admin)
GET http://localhost:8080/api/admin/students
Authorization: Bearer {{adminToken}}

### Get student 1 (admin)
GET http://localhost:8080/api/admin/students/1
Authorization: Bearer {{adminToken}}

### Update student 1 (admin)
PUT http://localhost:8080/api/admin/students/1
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "fullName": "Rahul Kumar Sharma",
  "course": "B.Tech CSE",
  "semester": 6
}

### Delete student 1 (admin)
DELETE http://localhost:8080/api/admin/students/1
Authorization: Bearer {{adminToken}}

### Login as the new student
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "email": "rahul@test.com",
  "password": "123456"
}

> {%
    client.global.set("studentToken", response.body.token);
%}

### My profile (student)
GET http://localhost:8080/api/student/me
Authorization: Bearer {{studentToken}}