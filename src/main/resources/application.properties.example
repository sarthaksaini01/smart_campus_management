spring.application.name=smart-campus
server.port=${PORT:8080}
spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/smart_campus}
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:change_me}
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.open-in-view=false

jwt.secret=${JWT_SECRET:change_me_base64_secret}
jwt.expiration-ms=86400000

app.cors.allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:5173}
app.bootstrap.admin-email=${ADMIN_EMAIL:}
app.bootstrap.admin-password=${ADMIN_PASSWORD:}

llm.base-url=${LLM_BASE_URL:https://api.groq.com/openai/v1}
llm.api-key=${LLM_API_KEY:}
llm.model=${LLM_MODEL:openai/gpt-oss-120b}
app.demo.seed=${DEMO_SEED:false}
app.demo.reset=${DEMO_RESET:false}